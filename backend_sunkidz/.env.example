DATABASE_URL=postgresql://postgres:Exora%40Solutions@localhost:5432/sunkidz_lms
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# UltraMsg WhatsApp Configuration
# Get these credentials from https://ultramsg.com dashboard
ULTRAMSG_API_URL=https://api.ultramsg.com
ULTRAMSG_INSTANCE_ID=your_instance_id_here
ULTRAMSG_AUTH_TOKEN=your_auth_token_here

# ---------------------------------------------------------------------------
# School calendar — Google Sheet (source of truth for working days / Learning
# Day numbers). Backend only; never shipped to the app, never commit real
# values or the service-account JSON.
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=19t0tc6RCruaIi5Jez3z89CUeRBAwNzPxfZb3RpNUuvY
SCHOOL_CALENDAR_BASE_TAB=Base Document
SCHOOL_CALENDAR_CACHE_TTL_SECONDS=300
# Preferred: paste the whole service-account JSON on one line. Or set
# GOOGLE_SERVICE_ACCOUNT_FILE to a path. Share the sheet with the service
# account's client_email as Viewer. If neither is set the backend falls back
# to the sheet's public CSV endpoint (needs "anyone with the link can view").
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional: per-branch calendar tabs, JSON {"<branch_uuid>": "<tab name>"}
SCHOOL_CALENDAR_BRANCH_TABS=

# ---------------------------------------------------------------------------
# n8n admission-document digitization (see backend README section "Admission
# document ingestion (n8n)" for the manual n8n-side setup this pairs with).
# ---------------------------------------------------------------------------
# Publicly reachable base URL of this backend (no trailing slash) — n8n uses
# it to fetch the uploaded file. e.g. https://api.sunkidz.example.com
BACKEND_PUBLIC_BASE_URL=
# The n8n Webhook node's URL. Left blank, uploads still work; they just stay
# in status="pending" until POST /api/v1/documents/{id}/retry-ocr is called.
N8N_WEBHOOK_URL=
# Shared secret n8n must send back as the `X-Service-Token` header on
# GET /documents/{id}/file and PATCH /documents/{id}/ocr-result. Generate a
# long random value, e.g. `openssl rand -hex 32` — put the SAME value in the
# n8n HTTP Request nodes' header.
N8N_SERVICE_TOKEN=

